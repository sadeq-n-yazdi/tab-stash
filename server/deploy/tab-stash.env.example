# Settings file of tab-stash-server. Copy it to /etc/tab-stash/tab-stash.env
# and change the values. systemd reads it (EnvironmentFile=), and the
# "-config <file>" option of all commands reads it too.
# Format: KEY=VALUE, one on each line. Lines that start with "#" are comments.

# The address of the server for its users. The server only shows it on the
# home page. Use the same address in the Tab Stash settings.
TAB_STASH_PUBLIC_URL=https://tabs.example.com/

# The secret salt of the server (also called a "pepper"). Each password hash
# also has its own random salt. This secret is kept here and not in the
# database, so a copy of the database alone is not enough to guess the
# passwords. Make it with:  tab-stash-server gen-salt
# Keep a copy in a safe place (for example a password manager). If you lose
# it or change it, no password works: set new passwords with "user passwd".
TAB_STASH_PASSWORD_SALT=

# The database file. The service user must be able to write to its folder.
TAB_STASH_DB=/var/lib/tab-stash/tab-stash.db

# The address and port to listen on. Use a loopback address behind a proxy.
TAB_STASH_ADDR=127.0.0.1:8080

# The header with the client address that the reverse proxy sets on each
# request. The login limit uses it. Leave it empty without a proxy.
#   Caddy, nginx with "proxy_set_header X-Real-IP $remote_addr": X-Real-IP
TAB_STASH_CLIENT_IP_HEADER=X-Real-IP

# The browser origins that can call the API, separated by commas.
TAB_STASH_ALLOW_ORIGIN=chrome-extension://icppdneajfbmmpkgejjpjfegkppmneej

# Optional: TLS without a proxy.
#TAB_STASH_TLS_CERT=/etc/tab-stash/cert.pem
#TAB_STASH_TLS_KEY=/etc/tab-stash/key.pem
