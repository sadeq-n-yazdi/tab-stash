# Caddy gets and renews the TLS certificate automatically.
# Change the host name to the name of your server.
tabs.example.com {
	encode gzip
	# The server does not send HSTS behind a proxy. The proxy sends it.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy 127.0.0.1:8080 {
		# The server reads the client address from this header
		# (TAB_STASH_CLIENT_IP_HEADER=X-Real-IP).
		header_up X-Real-IP {remote_host}
	}
}
