# systemd unit for tab-stash-server.
# Install: see server/README.md, part "Install on a Linux server".
[Unit]
Description=Tab Stash sync server
After=network.target

[Service]
Type=simple
User=tab-stash
Group=tab-stash
WorkingDirectory=/var/lib/tab-stash
# All settings are in this file. Example: deploy/tab-stash.env.example.
EnvironmentFile=/etc/tab-stash/tab-stash.env
ExecStart=/usr/local/bin/tab-stash-server serve
Restart=on-failure
RestartSec=5

# Memory. One login needs about 19 MiB for the password check.
Environment=GOMEMLIMIT=40MiB
MemoryHigh=64M
MemoryMax=96M

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/tab-stash
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
